.container {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.date {
  font-size: 28rpx;
  color: #666;
}

.meal-section {
  margin-bottom: 40rpx;
}

.meal-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.meal-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

.recipe-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.recipe-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.recipe-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.recipe-info {
  flex: 1;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.recipe-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.recipe-action {
  font-size: 24rpx;
  color: #FFB6C1;
}

.regenerate-btn {
  background: #FFB6C1;
  color: #fff;
  text-align: center;
  padding: 25rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 182, 193, 0.3);
}

.search-bar {
  position: relative;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(255,182,193,0.10);
  border: 1rpx solid #FFB6C1;
  height: 64rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  border: none;
  outline: none;
  background: transparent;
  padding: 0 30rpx 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #bbb;
  background: #f8f8f8;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.search-results {
  position: absolute;
  left: 0px;
  right: 0px;
  top: 44px;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  margin-bottom: 30rpx;
  padding: 10rpx 0;
  max-height: 470px;
  overflow-y: auto;
}

.search-result-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.search-result-item:last-child {
  border-bottom: none;
}
.result-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.result-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}
.no-result {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 30rpx 0;
} 